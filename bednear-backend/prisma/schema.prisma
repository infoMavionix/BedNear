
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CANDIDATE
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  INACTIVE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  CLOSED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  businessName String?
  role         UserRole @default(OWNER)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings      Listing[]
  enquiries     Enquiry[]      @relation("OwnerEnquiries")
  favorites     Favorite[]
  subscriptions Subscription[]

  @@index([role])
}

model Listing {
  id           String        @id @default(cuid())
  name         String
  category     String        @default("PG")
  description  String?
  address      String
  locality     String
  city         String        @default("Bengaluru")
  state        String        @default("Karnataka")
  pincode      String?
  latitude     Float?
  longitude    Float?
  genderPolicy String        @default("Any")
  monthlyRent  Int?
  deposit      Int?
  status       ListingStatus @default(DRAFT)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  rooms      Room[]
  images     ListingImage[]
  amenities  ListingAmenity[]
  enquiries  Enquiry[]
  favorites  Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([city, locality, status])
  @@index([status, monthlyRent])
  @@index([genderPolicy])
}

model Room {
  id          String  @id @default(cuid())
  name        String
  roomType    String  @default("Shared")
  capacity    Int     @default(1)
  monthlyRent Int?

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  beds      Bed[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
}

model Bed {
  id          String    @id @default(cuid())
  bedNumber   String
  status      BedStatus @default(AVAILABLE)
  monthlyRent Int?

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, bedNumber])
  @@index([roomId, status])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listingId, sortOrder])
}

model Amenity {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  listings ListingAmenity[]
}

model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([amenityId])
}

model Enquiry {
  id               String        @id @default(cuid())
  candidateName    String
  phone            String
  email            String?
  message           String?
  preferredVisitAt DateTime?
  status            EnquiryStatus @default(NEW)
  ownerNotes        String?

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("OwnerEnquiries", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([listingId, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  planName  String
  amount    Int
  currency  String             @default("INR")
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  payments Payment[]

  @@index([userId, status])
  @@index([expiresAt])
}

model Payment {
  id                String        @id @default(cuid())
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  receipt           String?       @unique
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, status])
}
